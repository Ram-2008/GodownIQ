# Supabase project settings (Project Settings > API)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic (Claude) API key — used for NL entry, photo bill parse, and AI forecast.
# App runs fine without it: those features show a graceful "unavailable" fallback.
ANTHROPIC_API_KEY=

# Twilio WhatsApp — only needed if WHATSAPP_ENABLED=true
WHATSAPP_ENABLED=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=

# Server
PORT=4000
# Comma-separated list of allowed origins for CORS (your Vercel frontend URL, localhost for dev)
FRONTEND_URL=http://localhost:5173

NODE_ENV=development
