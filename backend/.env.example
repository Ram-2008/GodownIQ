# Supabase project settings (Project Settings > API)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Google Gemini API key (from aistudio.google.com/apikey) — used for NL entry, photo
# bill parse, and AI forecast. App runs fine without it: those features show a
# graceful "unavailable" fallback.
GEMINI_API_KEY=

# Twilio WhatsApp — only needed if WHATSAPP_ENABLED=true
WHATSAPP_ENABLED=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=

# Server
PORT=4000
# Comma-separated list of allowed origins for CORS (your Vercel frontend URL, localhost for dev)
FRONTEND_URL=http://localhost:5173

NODE_ENV=development

# Only needed when deploying to Vercel — secret shared with the /api/cron/daily-alerts
# route so it can only be triggered by Vercel Cron, not the public internet. Leave blank
# for Railway/Render/local, where node-cron runs the same job on a persistent process instead.
CRON_SECRET=
